{{> local_elearning_system/client_styles }}

<style>
.es-orders-page {
    --es-primary: #0f6fc5;
    --es-primary-dark: #084f92;
    --es-success: #2e7d32;
    --es-success-light: #eaf7ec;
    --es-info-light: #eef7ff;
    --es-border: #d8e7f7;
    --es-text: #1f2937;
    --es-muted: #6b7280;
    --es-radius: 22px;

    min-height: 100vh;
    padding: 22px 0 44px;
    background:
        radial-gradient(circle at top left, rgba(15,111,197,.12), transparent 28%),
        linear-gradient(180deg, #f7fbff 0%, #ffffff 45%, #f8fbff 100%);
}

.es-orders-page .es-orders-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--es-border);
    border-radius: 28px;
    padding: 26px;
    margin-bottom: 24px;
    background:
        radial-gradient(circle at top right, rgba(15,111,197,.18), transparent 35%),
        linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
    box-shadow: 0 18px 45px rgba(15,111,197,.10);
}

.es-orders-page .es-orders-hero::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -80px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: rgba(15,111,197,.08);
}

.es-orders-page .es-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--es-border);
    color: var(--es-primary);
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 10px;
}

.es-orders-page .es-page-title {
    margin: 0 0 8px;
    font-size: 31px;
    line-height: 1.15;
    color: var(--es-text);
    font-weight: 900;
}

.es-orders-page .es-page-subtitle {
    max-width: 720px;
    margin: 0;
    color: var(--es-muted);
    font-size: 15px;
}

.es-orders-page .es-top-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
    position: relative;
    z-index: 2;
}

.es-orders-page .es-action-btn {
    border-radius: 999px;
    padding: 9px 15px;
    font-weight: 800;
    font-size: 13px;
    box-shadow: 0 7px 18px rgba(15,111,197,.08);
}

.es-orders-page .es-parent-alert {
    border: 1px solid #b9d7f5;
    background: #f1f8ff;
    color: #17446c;
    border-radius: 18px;
    padding: 14px 16px;
    margin-bottom: 20px;
}

.es-orders-page .es-orders-grid {
    row-gap: 24px;
}

.es-orders-page .es-order-card {
    height: 100%;
    border: 1px solid #dceaf8;
    border-radius: 24px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 16px 36px rgba(31,41,55,.08);
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}

.es-orders-page .es-order-card:hover {
    transform: translateY(-5px);
    border-color: #b7d9fa;
    box-shadow: 0 22px 48px rgba(15,111,197,.15);
}

.es-orders-page .es-order-image {
    position: relative;
    height: 205px;
    overflow: hidden;
    background: #f3f7fb;
}

.es-orders-page .es-order-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .25s ease;
}

.es-orders-page .es-order-card:hover .es-order-image img {
    transform: scale(1.04);
}

.es-orders-page .es-image-placeholder {
    height: 205px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f8fc, #edf4fb);
    color: #8a9aae;
}

.es-orders-page .es-order-id {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    background: rgba(255,255,255,.94);
    color: var(--es-primary);
    font-size: 12px;
    font-weight: 900;
    box-shadow: 0 8px 18px rgba(0,0,0,.08);
}

.es-orders-page .es-status {
    position: absolute;
    right: 14px;
    top: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
    box-shadow: 0 8px 18px rgba(0,0,0,.08);
}

.es-orders-page .es-status-active {
    background: rgba(234,247,236,.96);
    color: var(--es-success);
}

.es-orders-page .es-status-expired {
    background: rgba(243,244,246,.96);
    color: #4b5563;
}

.es-orders-page .es-order-body {
    padding: 18px;
}

.es-orders-page .es-order-title {
    margin: 0 0 8px;
    color: #102033;
    font-size: 18px;
    font-weight: 900;
}

.es-orders-page .es-order-course {
    color: var(--es-muted);
    font-size: 13px;
    margin-bottom: 12px;
}

.es-orders-page .es-order-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-end;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #eef2f7;
}

.es-orders-page .es-order-amount {
    color: var(--es-success);
    font-size: 20px;
    font-weight: 900;
}

.es-orders-page .es-order-date {
    color: var(--es-muted);
    font-size: 12px;
    text-align: right;
    line-height: 1.35;
}

.es-orders-page .es-order-footer {
    padding: 16px 18px 18px;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.es-orders-page .es-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.es-orders-page .es-detail-btn,
.es-orders-page .es-download-btn {
    border: none;
    border-radius: 15px;
    padding: 11px 12px;
    font-weight: 900;
    font-size: 13px;
    text-decoration: none !important;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
}

.es-orders-page .es-detail-btn {
    background: linear-gradient(135deg, #0f6fc5, #0097b2);
    color: #ffffff !important;
}

.es-orders-page .es-download-btn {
    background: linear-gradient(135deg, #2e7d32, #43a047);
    color: #ffffff !important;
}

.es-orders-page .es-empty-state {
    border: 1px dashed #bdd6ef;
    border-radius: 22px;
    padding: 38px 22px;
    text-align: center;
    background: #fbfdff;
    color: var(--es-muted);
    box-shadow: 0 12px 28px rgba(31,41,55,.05);
}

.es-orders-page .es-empty-state i {
    display: block;
    color: #8ebce8;
    margin-bottom: 12px;
}

/* Drawer */
.es-order-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,.45);
    display: none;
    z-index: 1050;
    backdrop-filter: blur(3px);
}

.es-order-drawer {
    position: fixed;
    top: 0;
    right: -800px;
    width: 800px;
    max-width: 100vw;
    height: 100vh;
    background: #ffffff;
    box-shadow: -12px 0 35px rgba(15,23,42,.20);
    overflow-y: auto;
    transition: right .28s ease;
    z-index: 1055;
}

.es-order-drawer-header {
    position: sticky;
    top: 0;
    z-index: 2;
    background: linear-gradient(135deg, #ffffff, #eef7ff);
    border-bottom: 1px solid #e5eef8;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.es-order-drawer-title {
    margin: 0;
    font-size: 20px;
    font-weight: 900;
    color: var(--es-text);
}

.es-order-close {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #cbdff3;
    background: #ffffff;
    color: #334155;
    font-weight: 900;
}

.es-order-drawer-content {
    padding: 22px;
}

.es-detail-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
}

.es-detail-head h5 {
    margin: 0;
    font-weight: 900;
    color: #102033;
}

.es-detail-image {
    width: 100%;
    max-height: 230px;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid #e5eef8;
}

.es-detail-box {
    border: 1px solid #e5eef8;
    border-radius: 18px;
    padding: 16px;
    background: #fbfdff;
}

.es-detail-row {
    margin-bottom: 10px;
    color: #334155;
}

.es-detail-label {
    font-weight: 900;
    color: #102033;
}

.es-bundle-item {
    height: 100%;
    border: 1px solid #e5eef8;
    border-radius: 18px;
    padding: 12px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(31,41,55,.06);
}

.es-bundle-item img {
    height: 120px;
    width: 100%;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 10px;
}

.es-bundle-item h6 {
    font-size: 14px;
    font-weight: 900;
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    .es-orders-page .es-page-title {
        font-size: 25px;
    }

    .es-orders-page .es-top-actions {
        justify-content: flex-start;
    }

    .es-orders-page .es-order-meta {
        align-items: flex-start;
        flex-direction: column;
    }

    .es-orders-page .es-order-date {
        text-align: left;
    }

    .es-order-drawer {
        width: 100vw;
        right: -100vw;
    }
}
.es-rtl {
    direction: rtl;
    text-align: right;
}

.es-rtl .es-top-actions {
    justify-content: flex-start;
}

.es-rtl .es-order-date {
    text-align: left;
}

.es-rtl .es-order-id {
    left: auto;
    right: 14px;
}

.es-rtl .es-status {
    right: auto;
    left: 14px;
}

.es-rtl .es-order-drawer {
    right: auto;
    left: -800px;
}

.es-rtl .es-order-drawer.is-open {
    left: 0;
}
/* ==================================================
   FIX COMMANDES PAGE WIDTH + RTL LAYOUT
   ================================================== */

body#page-local-elearning-system-commandes,
body#page-local-elearning_system-commandes {
    overflow-x: hidden !important;
}

.es-orders-page.es-client {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 22px 32px 44px !important;
}

.es-orders-page .container-fluid {
    width: 100% !important;
    max-width: 1180px !important;
    margin: 0 auto !important;
    padding-left: 16px !important;
    padding-right: 16px !important;
}

.es-orders-page .es-orders-hero {
    width: 100% !important;
}

.es-orders-page .es-orders-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    margin-left: -12px !important;
    margin-right: -12px !important;
}

.es-orders-page .es-orders-grid > [class*="col-"] {
    padding-left: 12px !important;
    padding-right: 12px !important;
    margin-bottom: 24px !important;
}

/* Desktop : 3 cards per row */
@media (min-width: 1200px) {
    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 33.333333% !important;
        max-width: 33.333333% !important;
    }
}

/* Tablet : 2 cards per row */
@media (min-width: 768px) and (max-width: 1199px) {
    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
}

/* Mobile : 1 card per row */
@media (max-width: 767px) {
    .es-orders-page {
        padding: 14px 12px 34px !important;
    }

    .es-orders-page .container-fluid {
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }
}

/* Better card proportions */
.es-orders-page .es-order-image,
.es-orders-page .es-image-placeholder {
    height: 190px !important;
}

.es-orders-page .es-order-body {
    padding: 14px 16px !important;
}

.es-orders-page .es-order-footer {
    padding: 14px 16px 16px !important;
}

.es-orders-page .es-card-actions {
    grid-template-columns: 1fr 1fr !important;
}

/* RTL correction without shrinking the page */
.es-orders-page.es-rtl {
    direction: rtl !important;
    text-align: right !important;
}

.es-orders-page.es-rtl .row {
    direction: rtl !important;
}

.es-orders-page.es-rtl .es-orders-grid {
    direction: rtl !important;
}

.es-orders-page.es-rtl .es-order-meta {
    direction: rtl !important;
}

.es-orders-page.es-rtl .es-order-date {
    text-align: left !important;
}

.es-orders-page.es-rtl .es-top-actions {
    justify-content: flex-start !important;
}
/* FIX COMMANDES PAGE WIDTH */
#page-local-elearning-system-commandes #region-main,
#page-local-elearning_system-commandes #region-main,
#page-local-elearning-system-commandes .region-main,
#page-local-elearning_system-commandes .region-main {
    max-width: none !important;
    width: 100% !important;
}

#page-local-elearning-system-commandes .main-inner,
#page-local-elearning_system-commandes .main-inner,
#page-local-elearning-system-commandes [role="main"],
#page-local-elearning_system-commandes [role="main"] {
    max-width: none !important;
    width: 100% !important;
}

.es-orders-page.es-client {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 22px 32px 44px !important;
}

.es-orders-page .container-fluid {
    width: 100% !important;
    max-width: 1180px !important;
    margin: 0 auto !important;
}

.es-orders-page .es-orders-grid > [class*="col-"] {
    margin-bottom: 24px !important;
}

@media (min-width: 1200px) {
    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 33.333333% !important;
        max-width: 33.333333% !important;
    }
}

@media (min-width: 768px) and (max-width: 1199px) {
    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
}

@media (max-width: 767px) {
    .es-orders-page .es-orders-grid > [class*="col-"] {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }
}
</style>

<div class="es-client es-orders-page {{#isrtl}}es-rtl{{/isrtl}}">
    <div class="container-fluid">

        <div class="es-orders-hero">
            <div class="row align-items-center g-3">
                <div class="col-12 col-lg-8">
                    <div class="es-kicker">
                        <i class="fa fa-receipt"></i>
                        {{t_orders_space}}
                    </div>
                    <h2 class="es-page-title">{{pageheading}}</h2>
                    <p class="es-page-subtitle">
                        {{t_subtitle}}
                    </p>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="es-top-actions">
                        <a href="{{mycoursesurl}}" class="btn btn-light es-action-btn">
                            <i class="fa fa-play-circle"></i> {{t_my_courses}}
                        </a>
                        <a href="{{homeurl}}" class="btn btn-outline-primary es-action-btn">
                            <i class="fa fa-th-large"></i> {{t_catalogue}}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {{#isparentaccount}}
        <div class="es-parent-alert">
            <i class="fa fa-user-friends"></i>
            {{t_parent_viewing}} <strong>{{targetfullname}}</strong>
        </div>
        {{/isparentaccount}}

        {{#hasorders}}
        <div class="row es-orders-grid">
            {{#orders}}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="es-order-card" onclick="openOrderDrawer({{id}})">
                    {{#hasproductimage}}
                    <div class="es-order-image">
                        <img src="{{productimage}}" alt="{{productname}}">
                        <span class="es-order-id">#{{id}}</span>
                        {{#isactiveorder}}<span class="es-status es-status-active">{{t_active}}</span>{{/isactiveorder}}
                        {{#isexpiredorder}}<span class="es-status es-status-expired">{{t_expired}}</span>{{/isexpiredorder}}
                    </div>
                    {{/hasproductimage}}

                    {{^hasproductimage}}
                    <div class="es-image-placeholder">
                        <div class="text-center">
                            <i class="fa fa-shopping-bag fa-2x"></i>
                            <div class="mt-2">{{t_no_image}}</div>
                        </div>
                        <span class="es-order-id">#{{id}}</span>
                    </div>
                    {{/hasproductimage}}

                    <div class="es-order-body">
                        <h5 class="es-order-title">{{productname}}</h5>

                        {{#hascourse}}
                        <div class="es-order-course">
                            <i class="fa fa-graduation-cap"></i> {{coursename}}
                        </div>
                        {{/hascourse}}

                        <div class="es-order-meta">
                            <div>
                                <div class="small text-muted">{{t_amount}}</div>
                                <div class="es-order-amount">{{amount}}</div>
                            </div>
                            <div class="es-order-date">
                                <i class="fa fa-calendar"></i>
                                {{timecreated}}
                            </div>
                        </div>
                    </div>

                    <div class="es-order-footer">
                        <div class="es-card-actions">
                            <button class="es-detail-btn" onclick="event.stopPropagation(); openOrderDrawer({{id}}); return false;">
                                <i class="fa fa-eye"></i> {{t_details}}
                            </button>

                            <a href="{{pdfurl}}" class="es-download-btn" onclick="event.stopPropagation(); triggerInvoiceDownload(this.href); return false;">
                                <i class="fa fa-download"></i> {{t_invoice}}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {{/orders}}
        </div>
        {{/hasorders}}

        {{^hasorders}}
        <div class="es-empty-state">
            <i class="fa fa-folder-open fa-3x"></i>
            <h5>{{t_empty_title}}</h5>
<p class="mb-0">{{t_empty_text}}</p>
        </div>
        {{/hasorders}}

    </div>

    {{#orders}}
    <template id="orderDetailTemplate{{id}}">
        <div class="order-detail-wrapper">
            <div class="es-detail-head">
                <h5>{{t_order}} #{{id}}</h5>
                <a href="{{pdfurl}}" class="es-download-btn" onclick="triggerInvoiceDownload(this.href); return false;">
                    <i class="fa fa-download"></i> {{t_download_pdf}}
                </a>
            </div>

            <div class="row g-3 mb-4">
                {{#hasproductimage}}
                <div class="col-md-5">
                    <img src="{{productimage}}" alt="{{productname}}" class="es-detail-image">
                </div>
                <div class="col-md-7">
                {{/hasproductimage}}

                {{^hasproductimage}}
                <div class="col-12">
                {{/hasproductimage}}

                    <div class="es-detail-box">
                        <h5 class="mb-3">{{productname}}</h5>

                        {{#hascourse}}
                        <div class="es-detail-row">
                            <span class="es-detail-label">{{t_course}} :</span>
                            <a href="{{courseurl}}" target="_blank">{{coursename}}</a>
                        </div>
                        {{/hascourse}}

                        <div class="es-detail-row">
                            <span class="es-detail-label">{{t_date}} :</span> {{timecreated}}
                        </div>

                        <div class="es-detail-row">
                           <span class="es-detail-label">{{t_duration}} :</span> {{durationlabel}}
                        </div>

                        <div class="es-detail-row">
                            <span class="es-detail-label">{{t_status}} :</span>
{{#isactiveorder}}<span class="badge bg-success">{{t_active_access}}</span>{{/isactiveorder}}
{{#isexpiredorder}}<span class="badge bg-secondary">{{t_expired_access}}</span>{{/isexpiredorder}}
                        </div>

                        <div class="es-detail-row">
                            <span class="es-detail-label">{{t_product_price}} :</span>
<span class="text-success fw-bold">{{productprice}}</span>
                        </div>

                        <div class="es-detail-row">
                            <span class="es-detail-label">{{t_order_amount}} :</span>
<span class="fw-bold">{{amount}}</span>
                        </div>

                        {{#hasdescription}}
                        <div class="mt-3">
                            <div class="es-detail-label mb-2">{{t_description}} :</div>
                            <div class="small text-muted">
                                {{description}}
                            </div>
                        </div>
                        {{/hasdescription}}
                    </div>
                </div>
            </div>

            {{#hasbundleitems}}
            <div class="border-top pt-4 mb-3">
                <h6 class="mb-3 fw-bold">
                    <i class="fa fa-layer-group"></i> {{t_bundle_items}}
                </h6>

                <div class="row g-3">
                    {{#bundleitems}}
                    <div class="col-md-6">
                        <div class="es-bundle-item">
                            {{#hasimage}}
                            <img src="{{image}}" alt="{{name}}">
                            {{/hasimage}}

                            <h6>{{name}}</h6>

                            {{#course}}
                            <a href="{{course.url}}" class="btn btn-sm btn-outline-primary">
                                {{t_access}}
                            </a>
                            {{/course}}
                        </div>
                    </div>
                    {{/bundleitems}}
                </div>
            </div>
            {{/hasbundleitems}}
        </div>
    </template>
    {{/orders}}

    <div id="orderDrawerOverlay" class="es-order-overlay"></div>

    <div id="orderDrawer" class="es-order-drawer">
        <div class="es-order-drawer-header">
            <h5 class="es-order-drawer-title">{{t_drawer_title}}</h5>
            <button type="button" class="es-order-close" onclick="closeOrderDrawer()">✕</button>
        </div>

        <div id="orderDrawerContent" class="es-order-drawer-content"></div>
    </div>
</div>

<script>
function openOrderDrawer(orderId) {
    var template = document.getElementById('orderDetailTemplate' + orderId);
    var content = document.getElementById('orderDrawerContent');
    var drawer = document.getElementById('orderDrawer');
    var overlay = document.getElementById('orderDrawerOverlay');

    if (!template || !content || !drawer || !overlay) {
        return;
    }

    content.innerHTML = template.innerHTML;
    overlay.style.display = 'block';
    if (document.querySelector('.es-orders-page.es-rtl')) {
    drawer.style.left = '0';
} else {
    drawer.style.right = '0';
}
}

function closeOrderDrawer() {
    var drawer = document.getElementById('orderDrawer');
    var overlay = document.getElementById('orderDrawerOverlay');

    if (drawer) {
        if (document.querySelector('.es-orders-page.es-rtl')) {
    drawer.style.left = window.innerWidth <= 768 ? '-100vw' : '-800px';
} else {
    drawer.style.right = window.innerWidth <= 768 ? '-100vw' : '-800px';
}
    }

    if (overlay) {
        overlay.style.display = 'none';
    }
}

function triggerInvoiceDownload(url) {
    if (url.indexOf('pdf=1') === -1) {
        var sep = url.indexOf('?') !== -1 ? '&' : '?';
        url = url + sep + 'pdf=1';
    }

    var separator = url.indexOf('?') !== -1 ? '&' : '?';
    window.location.href = url + separator + 'downloadts=' + Date.now();
}

document.getElementById('orderDrawerOverlay')?.addEventListener('click', function() {
    closeOrderDrawer();
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeOrderDrawer();
    }
});
</script>