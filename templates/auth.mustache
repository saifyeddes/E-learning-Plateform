{{> local_elearning_system/client_styles }}
<div class="es-client">
<style>
/* ==================================================
   AUTH PAGE FULL SCREEN - FIX MOODLE COMPRESSED LAYOUT
   ================================================== */

html,
body {
    margin: 0 !important;
    padding: 0 !important;
}

/* Forcer la page auth à ne pas dépendre du layout Moodle */
body#page-local-elearning_system-auth {
    overflow: hidden !important;
    background: #eef4ff !important;
}

/* Neutraliser les conteneurs Moodle */
body#page-local-elearning_system-auth #page-wrapper,
body#page-local-elearning_system-auth #page,
body#page-local-elearning_system-auth #page-content,
body#page-local-elearning_system-auth #region-main-box,
body#page-local-elearning_system-auth #region-main,
body#page-local-elearning_system-auth [role="main"],
body#page-local-elearning_system-auth .main-inner,
body#page-local-elearning_system-auth .container,
body#page-local-elearning_system-auth .container-fluid {
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: transparent !important;
}

/* Masquer les éléments Moodle inutiles */
body#page-local-elearning_system-auth header,
body#page-local-elearning_system-auth footer,
body#page-local-elearning_system-auth .navbar,
body#page-local-elearning_system-auth .secondary-navigation,
body#page-local-elearning_system-auth .drawer-toggles,
body#page-local-elearning_system-auth .activity-header,
body#page-local-elearning_system-auth .breadcrumb,
body#page-local-elearning_system-auth .es-chatbot-fab,
body#page-local-elearning_system-auth .es-chatbot-panel {
    display: none !important;
}

/* Important : annuler le padding global venant de client_styles */
body#page-local-elearning_system-auth .es-client {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    overflow: hidden !important;
    z-index: 9999;
}

/* Fond pleine page */
.es-auth-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    padding: 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
        radial-gradient(circle at 10% 15%, rgba(97, 184, 240, 0.22), transparent 34%),
        radial-gradient(circle at 90% 85%, rgba(72, 181, 150, 0.16), transparent 30%),
        linear-gradient(135deg, #f7fbff 0%, #edf5ff 48%, #ffffff 100%);
}

/* Carte principale */
.es-auth-wrapper {
    width: min(1120px, calc(100vw - 48px));
    height: min(680px, calc(100vh - 48px));
    display: grid;
    grid-template-columns: 440px 1fr;
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 28px 80px rgba(16, 42, 67, 0.18);
}

/* Colonne formulaire */
.es-auth-left {
    height: 100%;
    min-width: 0;
    padding: 34px 42px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
    overflow: hidden;
}

/* Colonne visuelle */
.es-auth-right {
    position: relative;
    height: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #ffffff;
    background:
        radial-gradient(circle at 65% 35%, rgba(255, 255, 255, 0.16), transparent 28%),
        linear-gradient(145deg, #102a43 0%, #006794 48%, #61b8f0 100%);
}

.es-auth-right::before {
    content: "";
    position: absolute;
    width: 360px;
    height: 360px;
    right: -120px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.11);
}

.es-auth-right::after {
    content: "";
    position: absolute;
    width: 190px;
    height: 190px;
    left: 45px;
    top: 45px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
}

/* Onglets */
.es-auth-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 5px;
    margin: 0 0 20px;
    background: #eef3f9;
    border-radius: 999px;
}

.es-auth-tab {
    height: 42px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #5e7087;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
}

.es-auth-tab.active {
    background: #ffffff;
    color: #006794;
    box-shadow: 0 5px 16px rgba(0, 103, 148, 0.14);
}

/* Login / Signup */
.es-auth-form-container {
    display: none !important;
    width: 100%;
}

.es-auth-form-container.active {
    display: block !important;
}

/* Titres */
.es-auth-title {
    margin: 0 0 6px !important;
    color: #102a43 !important;
    font-size: 28px !important;
    line-height: 1.1 !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em;
}

.es-auth-subtitle {
    margin: 0 0 18px !important;
    color: #627d98 !important;
    font-size: 14px !important;
    line-height: 1.45 !important;
}

/* Champs */
.es-auth-form-group {
    margin-bottom: 12px;
}

.es-auth-form-group label {
    display: block;
    margin-bottom: 6px;
    color: #243b53;
    font-size: 12.5px;
    font-weight: 700;
}

.es-auth-form-group input,
.es-auth-form-group select {
    width: 100%;
    height: 41px;
    padding: 9px 13px;
    border: 1px solid #d9e2ec;
    border-radius: 12px;
    background: #ffffff;
    color: #102a43;
    font-size: 14px;
    box-sizing: border-box;
    outline: none;
}

.es-auth-form-group input:focus,
.es-auth-form-group select:focus {
    border-color: #006794;
    box-shadow: 0 0 0 4px rgba(0, 103, 148, 0.12);
}

/* Champs en deux colonnes */
.es-auth-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

/* Bouton principal */
.es-auth-submit {
    width: 100%;
    height: 44px;
    margin-top: 6px;
    border: 0;
    border-radius: 13px;
    background: linear-gradient(135deg, #006794 0%, #0f6cbf 52%, #61b8f0 100%);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
}

.es-auth-submit:hover {
    filter: brightness(0.97);
}

/* Google */
.es-auth-social-separator {
    margin: 10px 0;
    text-align: center;
    color: #829ab1;
    font-size: 12px;
}

.es-auth-google {
    width: 100%;
    min-height: 41px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid #d9e2ec;
    border-radius: 12px;
    background: #ffffff;
    color: #243b53;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    box-sizing: border-box;
}

.es-auth-google:hover {
    background: #f8fbff;
    color: #243b53;
    text-decoration: none;
}

.es-auth-google-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
}

.es-auth-google-icon {
    width: 20px;
    height: 20px;
    border: 1px solid #d9e2ec;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #db4437;
    font-size: 13px;
    font-weight: 800;
}

/* Mot de passe oublié */
.es-auth-forgot {
    margin: 10px 0 0;
    text-align: right;
}

.es-auth-forgot a {
    color: #006794;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
}

/* Erreurs */
.es-auth-errors {
    margin-bottom: 12px;
    padding: 10px 12px;
    border: 1px solid #ffc9c9;
    border-radius: 12px;
    background: #fff5f5;
    color: #c92a2a;
    font-size: 13px;
}

/* Illustration droite */
.es-auth-illustration {
    position: relative;
    z-index: 1;
    width: min(380px, 82%);
    padding: 30px;
    text-align: center;
    box-sizing: border-box;
}

.es-auth-illustration svg {
    width: 220px;
    height: 220px;
    max-width: 100%;
}

.es-auth-illustration h3 {
    margin: 18px 0 8px !important;
    color: #ffffff !important;
    font-size: 22px !important;
    font-weight: 800 !important;
}

.es-auth-illustration p {
    margin: 0 !important;
    color: rgba(255, 255, 255, 0.86) !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
}

/* Toast */
.es-auth-toast {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 10000;
    max-width: 360px;
    padding: 12px 16px;
    border-radius: 12px;
    background: #fff8e6;
    border: 1px solid #ffe3a3;
    color: #7c4a03;
    box-shadow: 0 12px 30px rgba(16, 42, 67, 0.18);
    font-size: 13px;
}

/* Adapter quand la hauteur écran est petite */
@media (max-height: 720px) {
    .es-auth-container {
        padding: 12px;
    }

    .es-auth-wrapper {
        height: calc(100vh - 24px);
    }

    .es-auth-left {
        padding: 22px 34px;
    }

    .es-auth-tabs {
        margin-bottom: 13px;
    }

    .es-auth-title {
        font-size: 24px !important;
    }

    .es-auth-subtitle {
        margin-bottom: 12px !important;
        font-size: 13px !important;
    }

    .es-auth-form-group {
        margin-bottom: 8px;
    }

    .es-auth-form-group label {
        margin-bottom: 4px;
        font-size: 12px;
    }

    .es-auth-form-group input,
    .es-auth-form-group select,
    .es-auth-google,
    .es-auth-submit {
        height: 37px;
    }

    .es-auth-illustration svg {
        width: 170px;
        height: 170px;
    }

    .es-auth-illustration h3 {
        font-size: 19px !important;
    }

    .es-auth-illustration p {
        font-size: 13px !important;
    }
}

/* Tablette / mobile */
@media (max-width: 900px) {
    body#page-local-elearning_system-auth {
        overflow: auto !important;
    }

    body#page-local-elearning_system-auth .es-client {
        position: static !important;
        height: auto !important;
        min-height: 100vh !important;
        overflow: visible !important;
    }

    .es-auth-container {
        position: static;
        min-height: 100vh;
        height: auto;
        padding: 16px;
        overflow: visible;
    }

    .es-auth-wrapper {
        width: 100%;
        height: auto;
        min-height: auto;
        grid-template-columns: 1fr;
    }

    .es-auth-right {
        display: none;
    }

    .es-auth-left {
        padding: 30px 24px;
    }
}

@media (max-width: 520px) {
    .es-auth-container {
        padding: 0;
    }

    .es-auth-wrapper {
        min-height: 100vh;
        border-radius: 0;
    }

    .es-auth-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .es-auth-left {
        padding: 26px 20px;
    }
}
</style>

<div class="es-auth-container">
    {{#hasoauthtoast}}
    <div id="es-auth-toast" class="es-auth-toast">{{oauthtoastmessage}}</div>
    {{/hasoauthtoast}}

    <div class="es-auth-wrapper">
        <!-- Left Panel -->
        <div class="es-auth-left">
            <!-- Tabs -->
            <div class="es-auth-tabs">
                <button type="button" class="es-auth-tab active" onclick="switchAuthTab('login', this);">Login </button>
                <button type="button" class="es-auth-tab" onclick="switchAuthTab('signup', this);">SignUp</button>
            </div>

            <!-- Login Form -->
            <div id="login" class="es-auth-form-container active">
                <h2 class="es-auth-title">LOG IN</h2>
                <p class="es-auth-subtitle">Enter your credentials to access your account</p>

                {{#hasloginerrors}}
                <div class="es-auth-errors">
                    {{#loginerrors}}<div>{{message}}</div>{{/loginerrors}}
                </div>
                {{/hasloginerrors}}

                <form action="{{authurl}}" method="post" autocomplete="on">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="return" value="{{returnurl}}">
                    <input type="hidden" name="loginsubmit" value="1">

                    <div class="es-auth-form-group">
                        <label>Email Address</label>
                        <input type="text" name="login_username" value="{{loginidentifier}}" placeholder="your@email.com" required>
                    </div>

                    <div class="es-auth-form-group">
                        <label>Password</label>
                        <input type="password" name="login_password" placeholder="••••••••" required>
                    </div>

                    {{#hasoauthproviders}}
                    <div class="es-auth-social-separator">or</div>
                    {{#oauthproviders}}
                    <a class="es-auth-google" href="{{url}}">
                        {{#iconurl}}<img class="es-auth-google-img" src="{{iconurl}}" alt="{{name}}">{{/iconurl}}
                        {{^iconurl}}
                        <span class="es-auth-google-icon">G</span>
                        {{/iconurl}}
                        Continue with {{name}}
                    </a>
                    {{/oauthproviders}}
                    {{/hasoauthproviders}}

                    <div class="es-auth-forgot">
    <a href="{{forgotpasswordurl}}">Forgot Password?</a>
</div>

                    <button type="submit" class="es-auth-submit">Log In</button>
                </form>
            </div>

            <!-- Signup Form -->
            <div id="signup" class="es-auth-form-container">
                <h2 class="es-auth-title">SIGN UP</h2>
                <p class="es-auth-subtitle">Create your account to get started</p>

                {{#hasregistererrors}}
                <div class="es-auth-errors">
                    {{#registererrors}}<div>{{message}}</div>{{/registererrors}}
                </div>
                {{/hasregistererrors}}

                <form action="{{authurl}}" method="post" autocomplete="on">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="return" value="{{returnurl}}">
                    <input type="hidden" name="registersubmit" value="1">

                    <div class="es-auth-row">
                        <div class="es-auth-form-group">
                            <label>First Name</label>
                            <input type="text" name="reg_firstname" value="{{registerfirstname}}" placeholder="John" required>
                        </div>
                        <div class="es-auth-form-group">
                            <label>Last Name</label>
                            <input type="text" name="reg_lastname" value="{{registerlastname}}" placeholder="Doe" required>
                        </div>
                    </div>

                    <div class="es-auth-form-group">
                        <label>Username</label>
                        <input type="text" name="reg_username" value="{{registerusername}}" placeholder="johndoe" required>
                    </div>

                    <div class="es-auth-form-group">
                        <label>Email Address</label>
                        <input type="email" name="reg_email" value="{{registeremail}}" placeholder="you@example.com" required>
                    </div>

                    <div class="es-auth-form-group">
                        <label>Password</label>
                        <input type="password" name="reg_password" placeholder="••••••••" required>
                    </div>

                    <div class="es-auth-row">
                        <div class="es-auth-form-group">
                            <label>City</label>
                            <input type="text" name="reg_city" value="{{registercity}}" placeholder="New York">
                        </div>
                        <div class="es-auth-form-group">
                            <label>Country</label>
                            <select name="reg_country">
                                <option value="">Select...</option>
                                {{#countries}}<option value="{{code}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/countries}}
                            </select>
                        </div>
                    </div>

                    {{#hasoauthproviders}}
                    <div class="es-auth-social-separator">or</div>
                    {{#oauthproviders}}
                    <a class="es-auth-google" href="{{url}}">
                        {{#iconurl}}<img class="es-auth-google-img" src="{{iconurl}}" alt="{{name}}">{{/iconurl}}
                        {{^iconurl}}
                        <span class="es-auth-google-icon">G</span>
                        {{/iconurl}}
                        Continue with {{name}}
                    </a>
                    {{/oauthproviders}}
                    {{/hasoauthproviders}}

                    <button type="submit" class="es-auth-submit">Sign Up</button>
                </form>
            </div>
        </div>

        <!-- Right Panel with Illustration -->
        <div class="es-auth-right">
            <div class="es-auth-illustration">
                <svg width="280" height="280" viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="140" cy="140" r="120" fill="rgba(255,255,255,0.1)"/>
                    <rect x="92" y="88" width="54" height="74" rx="9" fill="rgba(255,255,255,0.95)"/>
<rect x="112" y="78" width="54" height="74" rx="9" fill="rgba(97,184,240,0.95)"/>
<rect x="132" y="98" width="54" height="74" rx="9" fill="rgba(72,181,150,0.95)"/>
<path d="M105 186H178" stroke="white" stroke-width="8" stroke-linecap="round"/>
                </svg>
                <h3 style="color: white; margin-top: 20px; font-size: 18px; font-weight: 600;">Welcome to E-learning</h3>
                <p style="color: rgba(255,255,255,0.8); font-size: 13px; margin-top: 10px;">Access thousands of courses<br>and start learning today</p>
            </div>
        </div>
    </div>
</div>

<script>
function switchAuthTab(tab, sourceButton) {
    // Hide all forms
    document.getElementById('login').classList.remove('active');
    document.getElementById('signup').classList.remove('active');
    
    // Remove active from all tabs
    document.querySelectorAll('.es-auth-tab').forEach(t => t.classList.remove('active'));
    
    // Show selected form
    document.getElementById(tab).classList.add('active');

    // Mark tab as active
    if (sourceButton) {
        sourceButton.classList.add('active');
    } else {
        var activeButton = tab === 'signup'
            ? document.querySelector('.es-auth-tab:nth-child(2)')
            : document.querySelector('.es-auth-tab:nth-child(1)');
        if (activeButton) {
            activeButton.classList.add('active');
        }
    }
}

{{#showsignuptab}}
switchAuthTab('signup');
{{/showsignuptab}}

(function() {
    var toast = document.getElementById('es-auth-toast');
    if (!toast) {
        return;
    }
    setTimeout(function() {
        toast.style.display = 'none';
    }, 6000);
})();
</script>

</div>
