{{> local_elearning_system/client_styles }}
<div class="es-client">
<div class="container-fluid">
    <div class="mb-3">
        <a href="{{backurl}}" class="btn btn-link p-0">{{t_backtocatalogue}}</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-lg-4 mb-3 mb-lg-0 text-center">
                    {{#hasimage}}
                    <img src="{{image}}" alt="{{name}}" class="img-fluid rounded" style="max-height: 300px; object-fit: cover;">
                    {{/hasimage}}
                    {{^hasimage}}
                    <div class="text-muted"><i class="fa fa-image"></i> {{t_noimage}}</div>
                    {{/hasimage}}
                </div>

                <div class="col-12 col-lg-8">
                    <h2 class="mb-2">{{name}}</h2>

                    <p class="mb-2">
                        <span class="badge {{#isfree}}bg-success{{/isfree}}{{#ispaid}}bg-primary{{/ispaid}}">{{type}}</span>
                    </p>

                    <p class="mb-2">
                        {{#isfree}}
                        <strong>{{t_price}}:</strong> {{t_free}}
                        {{/isfree}}
                        {{#ispaid}}
<strong>{{t_price}}:</strong>

{{#hasdiscount}}
<span class="es-old-price">{{originalprice}}</span>
<span class="es-sale-price">{{saleprice}}</span>
{{/hasdiscount}}

{{^hasdiscount}}
<span class="es-sale-price">{{displayprice}}</span>
{{/hasdiscount}}

{{/ispaid}}
                    </p>

                    <p class="mb-2"><strong>{{t_category}}:</strong> {{categoryname}}</p>
                    <p class="mb-3"><strong>{{t_course}}:</strong> {{coursename}}</p>

                    {{#isbundle}}
                    <div class="mb-3">
                        <h5 class="mb-2">{{t_bundleproducts}}</h5>
                        {{#hasbundleitems}}
                        <ul class="list-group">
                            {{#bundleitems}}
                            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div><strong>{{name}}</strong></div>
                                    <div class="small text-muted">
                                        {{#hascourse}}<a href="{{courseurl}}">{{coursename}}</a>{{/hascourse}}
                                        {{^hascourse}}{{coursename}}{{/hascourse}}
                                    </div>
                                </div>
                                {{#ispurchased}}<span class="badge bg-success">{{t_purchased}}</span>{{/ispurchased}}
                                {{^ispurchased}}<span class="badge bg-secondary">{{t_notpurchased}}</span>{{/ispurchased}}
                            </li>
                            {{/bundleitems}}
                        </ul>
                        {{/hasbundleitems}}
                        {{^hasbundleitems}}
                        <p class="text-muted mb-0">{{t_noproductsassignedtobundle}}</p>
                        {{/hasbundleitems}}
                    </div>
                    {{/isbundle}}

                    <div class="mb-4">
                        <h5>{{t_description}}</h5>
                        {{#hasdescription}}
                        <div>{{{description}}}</div>
                        {{/hasdescription}}
                        {{^hasdescription}}
                        <p class="text-muted mb-0">{{t_nodescriptionavailable}}</p>
                        {{/hasdescription}}
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        {{#ispurchased}}
                        <span class="btn btn-success disabled" aria-disabled="true">{{t_purchased}}</span>
                        {{/ispurchased}}
                        {{^ispurchased}}
                            {{#isincart}}
                            <a href="{{carturl}}" class="btn btn-outline-primary">{{t_incart}}</a>
                            {{/isincart}}
                            {{^isincart}}
                            <a href="{{addtocarturl}}" class="btn btn-primary">{{t_addtocart}}</a>
                            {{/isincart}}
                        {{/ispurchased}}
                        <a href="{{carturl}}" class="btn btn-outline-primary">{{t_viewcart}}</a>
                        {{#canopencourse}}
<a href="{{courseurl}}" class="btn btn-outline-secondary">{{t_opencourse}}</a>
{{/canopencourse}}

{{^canopencourse}}
    {{#hascourse}}
        {{^isloggedin}}
        <a href="{{authurl}}" class="btn btn-success">{{t_buynow}}</a>
        {{/isloggedin}}
    {{/hascourse}}
{{/canopencourse}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
