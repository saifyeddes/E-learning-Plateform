{{> local_elearning_system/client_styles }}

<style>
.es-my-courses-page {
    --es-primary: #0f6fc5;
    --es-primary-dark: #084f92;
    --es-success: #2e7d32;
    --es-success-light: #eaf7ec;
    --es-info-light: #eef7ff;
    --es-border: #d8e7f7;
    --es-text: #1f2937;
    --es-muted: #6b7280;
    --es-radius: 22px;

    min-height: 100vh;
    padding: 22px 32px 44px;
    background:
        radial-gradient(circle at top left, rgba(15,111,197,.12), transparent 28%),
        linear-gradient(180deg, #f7fbff 0%, #ffffff 45%, #f8fbff 100%);
}

.es-my-courses-page .container-fluid {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
}

.es-my-courses-page .es-courses-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--es-border);
    border-radius: 28px;
    padding: 26px;
    margin-bottom: 24px;
    background:
        radial-gradient(circle at top right, rgba(15,111,197,.18), transparent 35%),
        linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
    box-shadow: 0 18px 45px rgba(15,111,197,.10);
}

.es-my-courses-page .es-courses-hero::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -80px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: rgba(15,111,197,.08);
}

.es-my-courses-page .es-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--es-border);
    color: var(--es-primary);
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 10px;
}

.es-my-courses-page .es-page-title {
    margin: 0 0 8px;
    font-size: 31px;
    line-height: 1.15;
    color: var(--es-text);
    font-weight: 900;
}

.es-my-courses-page .es-page-subtitle {
    max-width: 720px;
    margin: 0;
    color: var(--es-muted);
    font-size: 15px;
}

.es-my-courses-page .es-top-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
    position: relative;
    z-index: 2;
}

.es-my-courses-page .es-action-btn {
    border-radius: 999px;
    padding: 9px 15px;
    font-weight: 800;
    font-size: 13px;
    box-shadow: 0 7px 18px rgba(15,111,197,.08);
}

.es-my-courses-page .es-parent-alert,
.es-my-courses-page .es-info-alert {
    border: 1px solid #b9d7f5;
    background: #f1f8ff;
    color: #17446c;
    border-radius: 18px;
    padding: 14px 16px;
    margin-bottom: 20px;
}

.es-my-courses-page .es-section {
    margin-bottom: 28px;
}

.es-my-courses-page .es-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
}

.es-my-courses-page .es-section-title {
    margin: 0;
    color: var(--es-text);
    font-size: 22px;
    font-weight: 900;
}

.es-my-courses-page .es-section-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--es-border);
    color: var(--es-primary);
    font-size: 12px;
    font-weight: 900;
}

.es-my-courses-page .es-courses-grid {
    row-gap: 24px;
}

.es-my-courses-page .es-course-card {
    height: 100%;
    border: 1px solid #dceaf8;
    border-radius: 24px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 16px 36px rgba(31,41,55,.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}

.es-my-courses-page .es-course-card:hover {
    transform: translateY(-5px);
    border-color: #b7d9fa;
    box-shadow: 0 22px 48px rgba(15,111,197,.15);
}

.es-my-courses-page .es-course-image {
    position: relative;
    height: 205px;
    overflow: hidden;
    background: #f3f7fb;
}

.es-my-courses-page .es-course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .25s ease;
}

.es-my-courses-page .es-course-card:hover .es-course-image img {
    transform: scale(1.04);
}

.es-my-courses-page .es-image-placeholder {
    height: 205px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f8fc, #edf4fb);
    color: #8a9aae;
}

.es-my-courses-page .es-course-status {
    position: absolute;
    right: 14px;
    top: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    background: rgba(234,247,236,.96);
    color: var(--es-success);
    font-size: 12px;
    font-weight: 900;
    box-shadow: 0 8px 18px rgba(0,0,0,.08);
}

.es-my-courses-page .es-course-body {
    padding: 18px;
}

.es-my-courses-page .es-course-title {
    margin: 0 0 8px;
    color: #102033;
    font-size: 18px;
    font-weight: 900;
}

.es-my-courses-page .es-course-subtitle {
    color: var(--es-muted);
    font-size: 13px;
    margin-bottom: 12px;
}

.es-my-courses-page .es-course-meta {
    color: var(--es-muted);
    font-size: 12px;
    line-height: 1.35;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #eef2f7;
}

.es-my-courses-page .es-course-price {
    color: var(--es-success);
    font-size: 18px;
    font-weight: 900;
    margin-top: 12px;
}

.es-my-courses-page .es-course-footer {
    padding: 16px 18px 18px;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.es-my-courses-page .es-card-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
}

.es-my-courses-page .es-main-btn,
.es-my-courses-page .es-secondary-btn,
.es-my-courses-page .es-success-btn {
    border: none;
    border-radius: 15px;
    padding: 11px 12px;
    font-weight: 900;
    font-size: 13px;
    text-decoration: none !important;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
}

.es-my-courses-page .es-main-btn {
    background: linear-gradient(135deg, #0f6fc5, #0097b2);
    color: #ffffff !important;
}

.es-my-courses-page .es-success-btn {
    background: linear-gradient(135deg, #2e7d32, #43a047);
    color: #ffffff !important;
}

.es-my-courses-page .es-secondary-btn {
    background: #ffffff;
    color: var(--es-primary) !important;
    border: 1px solid #bfd9f3;
}

.es-my-courses-page .es-empty-state {
    border: 1px dashed #bdd6ef;
    border-radius: 22px;
    padding: 38px 22px;
    text-align: center;
    background: #fbfdff;
    color: var(--es-muted);
    box-shadow: 0 12px 28px rgba(31,41,55,.05);
}

.es-my-courses-page .es-empty-state i {
    display: block;
    color: #8ebce8;
    margin-bottom: 12px;
}

.es-expired-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(12, 31, 56, 0.42);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.es-expired-modal {
    position: relative;
    width: min(520px, 100%);
    max-height: 85vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 22px;
    border: 1px solid #d8e3ef;
    box-shadow: 0 24px 70px rgba(12, 31, 56, 0.28);
    padding: 2rem;
    text-align: center;
}

.es-expired-modal-close {
    position: absolute;
    top: 14px;
    right: 16px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 999px;
    background: #eef4fb;
    color: #12304f;
    font-size: 1.4rem;
    line-height: 1;
}

.es-expired-modal-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, #0f6cbf, #1d9a8a);
    color: #ffffff;
    font-size: 1.8rem;
}

.es-expired-course {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 16px;
    background: #f5f9fd;
    border: 1px solid #dce8f5;
}

.es-expired-course + .es-expired-course {
    margin-top: 0.8rem;
}

/* RTL */
.es-my-courses-page.es-rtl {
    direction: rtl;
    text-align: right;
}

.es-my-courses-page.es-rtl .row {
    direction: rtl;
}

.es-my-courses-page.es-rtl .es-top-actions {
    justify-content: flex-start;
}

.es-my-courses-page.es-rtl .es-course-status {
    right: auto;
    left: 14px;
}

.es-my-courses-page.es-rtl .es-courses-hero::after {
    right: auto;
    left: -80px;
}

.es-my-courses-page.es-rtl .es-expired-modal-close {
    right: auto;
    left: 16px;
}

/* Width fix */
#page-local-elearning-system-my-courses #region-main,
#page-local-elearning_system-my_courses #region-main,
#page-local-elearning-system-my-courses .region-main,
#page-local-elearning_system-my_courses .region-main {
    max-width: none !important;
    width: 100% !important;
}

#page-local-elearning-system-my-courses .main-inner,
#page-local-elearning_system-my_courses .main-inner,
#page-local-elearning-system-my-courses [role="main"],
#page-local-elearning_system-my_courses [role="main"] {
    max-width: none !important;
    width: 100% !important;
}

@media (max-width: 768px) {
    .es-my-courses-page {
        padding: 14px 12px 34px;
    }

    .es-my-courses-page .es-page-title {
        font-size: 25px;
    }

    .es-my-courses-page .es-top-actions {
        justify-content: flex-start;
    }

    .es-my-courses-page .es-course-image,
    .es-my-courses-page .es-image-placeholder {
        height: 185px;
    }
}
</style>

<div class="es-client es-my-courses-page {{#isrtl}}es-rtl{{/isrtl}}">
    <div class="container-fluid">

        <div class="es-courses-hero">
            <div class="row align-items-center g-3">
                <div class="col-12 col-lg-8">
                    <div class="es-kicker">
                        <i class="fa fa-graduation-cap"></i>
                        {{t_page_title}}
                    </div>
                    <h2 class="es-page-title">{{t_page_title}}</h2>
                    <p class="es-page-subtitle">
                        {{t_orders_info_before}} <a href="{{commandesurl}}">{{t_orders_info_link}}</a>.
                    </p>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="es-top-actions">
                        <a href="{{homeurl}}" class="btn btn-light es-action-btn">
                            <i class="fa fa-th-large"></i> {{t_catalogue}}
                        </a>
                        <a href="{{carturl}}" class="btn btn-outline-primary es-action-btn">
                            <i class="fa fa-shopping-cart"></i> {{t_cart}}
                        </a>
                        <a href="{{commandesurl}}" class="btn btn-info es-action-btn">
                            <i class="fa fa-list"></i> {{t_orders}}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {{#isparentaccount}}
        <div class="es-parent-alert">
            <i class="fa fa-user-friends"></i>
            {{t_parent_viewing}} <strong>{{targetfullname}}</strong>
        </div>
        {{/isparentaccount}}

        <div class="es-section">
            <div class="es-section-header">
                <h3 class="es-section-title">{{t_purchased_courses}}</h3>
                <span class="es-section-badge">
                    <i class="fa fa-check-circle"></i> {{t_purchased_courses}}
                </span>
            </div>

            {{#hascourses}}
            <div class="row es-courses-grid">
                {{#courses}}
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="es-course-card">
                        {{#hasproductimage}}
                        <div class="es-course-image">
                            <img src="{{productimage}}" alt="{{coursename}}">
                            <span class="es-course-status">
                                <i class="fa fa-check"></i> {{t_purchased_courses}}
                            </span>
                        </div>
                        {{/hasproductimage}}

                        {{^hasproductimage}}
                        <div class="es-image-placeholder">
                            <div class="text-center">
                                <i class="fa fa-image fa-2x"></i>
                                <div class="mt-2">{{t_no_image}}</div>
                            </div>
                            <span class="es-course-status">
                                <i class="fa fa-check"></i> {{t_purchased_courses}}
                            </span>
                        </div>
                        {{/hasproductimage}}

                        <div class="es-course-body">
                            <h5 class="es-course-title">{{coursename}}</h5>

                            {{#showproductname}}
                            <div class="es-course-subtitle">
                                <i class="fa fa-book"></i> {{productname}}
                            </div>
                            {{/showproductname}}

                            <div class="es-course-meta">
                                <i class="fa fa-calendar"></i> {{purchaseat}}
                            </div>
                        </div>

                        <div class="es-course-footer">
                            <div class="es-card-actions">
                                {{#canstartcourse}}
                                <a href="{{courseurl}}" class="es-success-btn">
                                    <i class="fa fa-play"></i> {{t_start_course}}
                                </a>
                                {{/canstartcourse}}

                                {{#canparentactions}}
                                <a href="{{invoiceurl}}" class="es-success-btn">
                                    <i class="fa fa-download"></i> {{t_download_invoice}}
                                </a>

                                <a href="{{progressurl}}" class="es-secondary-btn">
                                    <i class="fa fa-chart-line"></i> {{t_view_progress}}
                                </a>
                                {{/canparentactions}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/courses}}
            </div>
            {{/hascourses}}

            {{^hascourses}}
            <div class="es-empty-state">
                <i class="fa fa-folder-open fa-3x"></i>
                <h5>{{t_no_purchased_courses}}</h5>
            </div>
            {{/hascourses}}
        </div>

        <div class="es-info-alert">
            <i class="fa fa-info-circle"></i>
            {{t_orders_info_before}} <a href="{{commandesurl}}" class="alert-link">{{t_orders_info_link}}</a>.
        </div>

        <div class="es-section">
            <div class="es-section-header">
                <h3 class="es-section-title">{{t_available_courses}}</h3>
                <span class="es-section-badge">
                    <i class="fa fa-shopping-bag"></i> {{t_available_courses}}
                </span>
            </div>

            {{#hasavailablecourses}}
            <div class="row es-courses-grid">
                {{#availablecourses}}
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="es-course-card">
                        {{#hasproductimage}}
                        <div class="es-course-image">
                            <img src="{{productimage}}" alt="{{productname}}">
                        </div>
                        {{/hasproductimage}}

                        {{^hasproductimage}}
                        <div class="es-image-placeholder">
                            <div class="text-center">
                                <i class="fa fa-image fa-2x"></i>
                                <div class="mt-2">{{t_no_image}}</div>
                            </div>
                        </div>
                        {{/hasproductimage}}

                        <div class="es-course-body">
                            <h5 class="es-course-title">{{productname}}</h5>

                            {{#hascoursename}}
                            <div class="es-course-subtitle">
                                <i class="fa fa-graduation-cap"></i> {{coursename}}
                            </div>
                            {{/hascoursename}}

                            {{#isfree}}
                            <div class="es-course-price">{{t_free}}</div>
                            {{/isfree}}

                            {{^isfree}}
                            <div class="es-course-price">{{price}}</div>
                            {{/isfree}}
                        </div>

                        <div class="es-course-footer">
                            <div class="es-card-actions">
                                <a href="{{producturl}}" class="es-main-btn">
                                    <i class="fa fa-eye"></i> {{t_view_buy}}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/availablecourses}}
            </div>
            {{/hasavailablecourses}}

            {{^hasavailablecourses}}
            {{#alleligibleproductspurchased}}
            <div class="es-empty-state">
                <i class="fa fa-check-circle fa-3x"></i>
                <h5>{{t_all_purchased_child}}</h5>
            </div>
            {{/alleligibleproductspurchased}}

            {{^alleligibleproductspurchased}}
            <div class="es-empty-state">
                <i class="fa fa-shopping-bag fa-3x"></i>
                <h5>{{t_no_available_courses}}</h5>
            </div>
            {{/alleligibleproductspurchased}}
            {{/hasavailablecourses}}
        </div>

    </div>
</div>

{{#hasexpiredcourses}}
<div class="es-expired-modal-backdrop" id="esExpiredModalBackdrop">
    <div class="es-expired-modal {{#isrtl}}es-rtl{{/isrtl}}">
        <button type="button" class="es-expired-modal-close" id="esExpiredModalClose" aria-label="Close">
            &times;
        </button>

        <div class="es-expired-modal-icon">
            <i class="fa fa-lock"></i>
        </div>

        <h3>{{t_expired_title}}</h3>

        {{#expiredcourses}}
        <div class="es-expired-course">
            <p>
                {{t_expired_text_before}} <strong>{{coursename}}</strong> {{t_expired_text_after}}
            </p>
            <p class="text-muted">
                {{t_last_duration}}: {{durationlabel}}<br>
                {{t_expired_on}}: {{expirationdate}}
            </p>

            <a href="{{reactivateurl}}" class="btn btn-primary">
                {{t_reactivate_payment}}
            </a>
        </div>
        {{/expiredcourses}}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var backdrop = document.getElementById('esExpiredModalBackdrop');
    var closeBtn = document.getElementById('esExpiredModalClose');

    if (!backdrop || !closeBtn) {
        return;
    }

    closeBtn.addEventListener('click', function() {
        backdrop.classList.add('d-none');
    });

    backdrop.addEventListener('click', function(e) {
        if (e.target === backdrop) {
            backdrop.classList.add('d-none');
        }
    });
});
</script>
{{/hasexpiredcourses}}