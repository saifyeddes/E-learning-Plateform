<style>

.es-expired-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(12, 31, 56, 0.42);
    backdrop-filter: blur(3px);

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 1rem;
}

.es-expired-modal {
    position: relative;
    width: min(520px, 100%);
    max-height: 85vh;
    overflow-y: auto;

    background: #ffffff;
    border-radius: 22px;
    border: 1px solid #d8e3ef;
    box-shadow: 0 24px 70px rgba(12, 31, 56, 0.28);

    padding: 2rem;
    text-align: center;
}

.es-expired-modal-close {
    position: absolute;
    top: 14px;
    right: 16px;

    width: 34px;
    height: 34px;

    border: 0;
    border-radius: 999px;
    background: #eef4fb;
    color: #12304f;

    font-size: 1.4rem;
    line-height: 1;
}

.es-expired-modal-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 18px;
    background: linear-gradient(135deg, #0f6cbf, #1d9a8a);
    color: #ffffff;
    font-size: 1.8rem;
}

.es-expired-course {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 16px;
    background: #f5f9fd;
    border: 1px solid #dce8f5;
}

.es-expired-course + .es-expired-course {
    margin-top: 0.8rem;
}
</style>
{{> local_elearning_system/client_styles }}
<div class="es-client">
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="mb-0">Mes cours et commandes</h3>
            <div class="d-flex gap-2">
                <a href="{{homeurl}}" class="btn btn-outline-primary btn-sm">Catalogue</a>
                <a href="{{carturl}}" class="btn btn-outline-secondary btn-sm">Panier</a>
                <a href="{{commandesurl}}" class="btn btn-info btn-sm">
                    <i class="fa fa-list"></i> Commandes
                </a>
            </div>
        </div>
    </div>

    {{#isparentaccount}}
    <div class="alert alert-info">
        Vous consultez les cours de votre enfant: <strong>{{targetfullname}}</strong>
    </div>
    {{/isparentaccount}}

    <div class="card mb-3">
        <div class="card-header"><strong>Cours achetés</strong></div>
        <div class="card-body">
            {{#hascourses}}
            <div class="row g-4">
                {{#courses}}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden">
                        {{#hasproductimage}}
                        <div class="position-relative" style="height:200px; overflow:hidden;">
                            <img src="{{productimage}}" alt="{{coursename}}" class="img-fluid w-100 h-100" style="object-fit:cover;">
                        </div>
                        {{/hasproductimage}}
                        {{^hasproductimage}}
                        <div class="bg-light w-100" style="height:200px; display:flex; align-items:center; justify-content:center;">
                            <div class="text-muted text-center">
                                <i class="fa fa-image fa-2x"></i>
                                <p class="mt-2">Pas d'image</p>
                            </div>
                        </div>
                        {{/hasproductimage}}
                        
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">{{coursename}}</h6>
                            {{#showproductname}}
                            <div class="text-muted small mb-2">{{productname}}</div>
                            {{/showproductname}}
                            <div class="text-muted small mb-3">
                                <i class="fa fa-calendar"></i> {{purchaseat}}
                            </div>
                            <a href="{{courseurl}}" class="btn btn-success btn-sm mt-auto">
                                <i class="fa fa-play"></i> Démarrer le cours
                            </a>
                        </div>
                    </div>
                </div>
                {{/courses}}
            </div>
            {{/hascourses}}
            {{^hascourses}}
            <div class="alert alert-info mb-0">Aucun cours acheté pour le moment.</div>
            {{/hascourses}}
        </div>
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <i class="fa fa-info-circle"></i> Pour voir toutes vos commandes avec détails complets et télécharger vos factures, visitez la <a href="{{commandesurl}}" class="alert-link">page des commandes</a>.
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>Cours non achetés</strong></div>
        <div class="card-body">
            {{#hasavailablecourses}}
            <div class="row g-4">
                {{#availablecourses}}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden">
                        {{#hasproductimage}}
                        <div class="position-relative" style="height:200px; overflow:hidden;">
                            <img src="{{productimage}}" alt="{{productname}}" class="img-fluid w-100 h-100" style="object-fit:cover;">
                        </div>
                        {{/hasproductimage}}
                        {{^hasproductimage}}
                        <div class="bg-light w-100" style="height:200px; display:flex; align-items:center; justify-content:center;">
                            <div class="text-muted text-center">
                                <i class="fa fa-image fa-2x"></i>
                                <p class="mt-2">Pas d'image</p>
                            </div>
                        </div>
                        {{/hasproductimage}}

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-1">{{productname}}</h6>
                            {{#hascoursename}}
                            <div class="small text-muted mb-2">{{coursename}}</div>
                            {{/hascoursename}}
                            {{#isfree}}
                            <div class="text-success fw-bold mb-3">Gratuit</div>
                            {{/isfree}}
                            {{^isfree}}
                            <div class="text-success fw-bold mb-3">${{price}}</div>
                            {{/isfree}}
                            <a href="{{producturl}}" class="btn btn-primary btn-sm mt-auto">
                                Voir / Acheter
                            </a>
                        </div>
                    </div>
                </div>
                {{/availablecourses}}
            </div>
            {{/hasavailablecourses}}
            {{^hasavailablecourses}}
            {{#alleligibleproductspurchased}}
            <div class="alert alert-success mb-0">Tous les cours sont déjà achetés pour cet enfant.</div>
            {{/alleligibleproductspurchased}}
            {{^alleligibleproductspurchased}}
            <div class="alert alert-secondary mb-0">Aucun cours disponible dans le catalogue pour le moment.</div>
            {{/alleligibleproductspurchased}}
            {{/hasavailablecourses}}
        </div>
    </div>

</div>

</div>
{{#hasexpiredcourses}}
<div class="es-expired-modal-backdrop" id="esExpiredModalBackdrop">
    <div class="es-expired-modal">
        <button type="button" class="es-expired-modal-close" id="esExpiredModalClose" aria-label="Close">
            &times;
        </button>

        <div class="es-expired-modal-icon">
            <i class="fa fa-lock"></i>
        </div>

        <h3>Course access expired</h3>

        {{#expiredcourses}}
        <div class="es-expired-course">
            <p>
                Your course <strong>{{coursename}}</strong> is disabled now.
            </p>
            <p class="text-muted">
                Last duration: {{durationlabel}}<br>
                Expired on: {{expirationdate}}
            </p>

            <a href="{{reactivateurl}}" class="btn btn-primary">
                Reactivate payment
            </a>
        </div>
        {{/expiredcourses}}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var backdrop = document.getElementById('esExpiredModalBackdrop');
    var closeBtn = document.getElementById('esExpiredModalClose');

    if (!backdrop || !closeBtn) {
        return;
    }

    closeBtn.addEventListener('click', function() {
        backdrop.classList.add('d-none');
    });

    backdrop.addEventListener('click', function(e) {
        if (e.target === backdrop) {
            backdrop.classList.add('d-none');
        }
    });
});
</script>
{{/hasexpiredcourses}}
