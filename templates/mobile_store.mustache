<ion-content class="ion-padding">

    <ion-card>
        <ion-card-header>
            <ion-card-title>Dourouss E-Learning</ion-card-title>
            <ion-card-subtitle>Bienvenue {{fullname}}</ion-card-subtitle>
        </ion-card-header>

        <ion-card-content>
            Accédez rapidement à vos cours, votre panier et vos achats.
        </ion-card-content>
    </ion-card>

    <ion-list>

        <ion-item button href="{{storeurl}}">
            <ion-icon name="school-outline" slot="start"></ion-icon>
            <ion-label>
                <h2>Catalogue des cours</h2>
                <p>Voir les cours disponibles</p>
            </ion-label>
        </ion-item>

        <ion-item button href="{{mycoursesurl}}">
            <ion-icon name="book-outline" slot="start"></ion-icon>
            <ion-label>
                <h2>Mes cours</h2>
                <p>Accéder aux cours achetés</p>
            </ion-label>
        </ion-item>

        <ion-item button href="{{carturl}}">
            <ion-icon name="cart-outline" slot="start"></ion-icon>
            <ion-label>
                <h2>Panier</h2>
                <p>Consulter les cours ajoutés</p>
            </ion-label>
        </ion-item>

    </ion-list>

</ion-content>